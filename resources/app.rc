#pragma code_page(65001)
#include <windows.h>
#include "resource.h"
#include "version.h"
IDI_APP ICON "../docs/assets/logo.ico"
IDB_BANNER_EN BITMAP "../docs/assets/app-banner.en.bmp"
IDB_BANNER_VI BITMAP "../docs/assets/app-banner.vi.bmp"
1 RT_MANIFEST "app.manifest"
1 VERSIONINFO
FILEVERSION APP_VERSION_NUM
PRODUCTVERSION APP_VERSION_NUM
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "ZaloSnooze"
   VALUE "FileVersion", APP_VERSION
   VALUE "ProductName", "ZaloSnooze"
   VALUE "ProductVersion", APP_VERSION
   VALUE "LegalCopyright", "Copyright (c) 2026 ZaloSnooze contributors. MIT License."
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
IDD_MAIN DIALOGEX 0, 0, 320, 182
STYLE DS_SETFONT | DS_CENTER | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "ZaloSnooze"
FONT 9, "Segoe UI"
BEGIN
 CONTROL "", IDC_BANNER, "Static", SS_OWNERDRAW, 0, 0, 320, 34
 LTEXT "", IDC_META, 12, 42, 296, 12
 DEFPUSHBUTTON "Enable automatic startup", IDC_STARTUP, 12, 62, 296, 24
 CONTROL "Minimize Zalo to the taskbar instead of the tray", IDC_MINIMIZE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 88, 296, 16
 LTEXT "", IDC_INTRO, 12, 108, 296, 22
 LTEXT "Zalo locations", IDC_PATHLABEL, 12, 134, 296, 12
 LISTBOX IDC_PATHS, 12, 148, 248, 20, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_HSCROLL | WS_VSCROLL | WS_TABSTOP
 CONTROL "Manage locations", IDC_SETTINGS, "Button", BS_PUSHBUTTON | BS_ICON | WS_TABSTOP, 264, 148, 20, 20
 CONTROL "Open Zalo folder", IDC_OPEN_ZALO, "Button", BS_PUSHBUTTON | BS_ICON | WS_TABSTOP, 288, 148, 20, 20
 LTEXT "", IDC_STATUS, 12, 174, 296, 12
END
IDD_SETTINGS DIALOGEX 0, 0, 340, 168
STYLE DS_SETFONT | DS_CENTER | WS_CAPTION | WS_SYSMENU
CAPTION "Zalo locations"
FONT 9, "Segoe UI"
BEGIN
 CONTROL "Find Zalo automatically", IDC_AUTO, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 12, 316, 16
 LTEXT "", IDC_PATHLABEL, 12, 34, 316, 24
 LISTBOX IDC_PATHS, 12, 64, 316, 32, LBS_EXTENDEDSEL | LBS_NOINTEGRALHEIGHT | LBS_NOTIFY | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
 PUSHBUTTON "Add...", IDC_BROWSE, 12, 104, 70, 20
 PUSHBUTTON "Remove", IDC_REMOVE, 88, 104, 70, 20
 DEFPUSHBUTTON "Save", IDOK, 182, 136, 70, 20
 PUSHBUTTON "Cancel", IDCANCEL, 258, 136, 70, 20
END
IDD_ADVANCED DIALOGEX 0, 0, 340, 244
STYLE DS_SETFONT | DS_CENTER | WS_CAPTION | WS_SYSMENU
CAPTION "Experimental"
FONT 9, "Segoe UI"
BEGIN
 LTEXT "Defaults work for normal use. Overrides may prevent detection.", IDC_ADVNOTE, 12, 12, 316, 24
 LTEXT "Window class", 1201, 12, 48, 110, 12
 EDITTEXT IDC_CLASS, 130, 45, 198, 18, ES_AUTOHSCROLL
 LTEXT "Process names (comma-separated)", 1202, 12, 75, 110, 25
 EDITTEXT IDC_PROCESSES, 130, 72, 198, 18, ES_AUTOHSCROLL
 LTEXT "Quiet period (seconds)", 1203, 12, 108, 110, 12
 EDITTEXT IDC_GRACE, 130, 105, 45, 18, ES_NUMBER
 LTEXT "Watch limit (seconds)", 1204, 190, 108, 85, 24
 EDITTEXT IDC_MAXIMUM, 283, 105, 45, 18, ES_NUMBER
 LTEXT "Minimum width / height", 1205, 12, 141, 110, 12
 EDITTEXT IDC_WIDTH, 130, 138, 45, 18, ES_NUMBER
 EDITTEXT IDC_HEIGHT, 184, 138, 45, 18, ES_NUMBER
 CONTROL "Enable diagnostic log", IDC_LOG, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 171, 316, 16
 CONTROL "Experimental flicker suppression (opacity)", IDC_OPACITY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 192, 316, 16
 DEFPUSHBUTTON "Save", IDOK, 182, 214, 70, 20
 PUSHBUTTON "Cancel", IDCANCEL, 258, 214, 70, 20
END
IDD_ABOUT DIALOGEX 0, 0, 300, 142
STYLE DS_SETFONT | DS_CENTER | WS_CAPTION | WS_SYSMENU
CAPTION "About ZaloSnooze"
FONT 9, "Segoe UI"
BEGIN
 CONTROL "", IDC_ABOUT_ICON, "Static", SS_ICON | SS_REALSIZECONTROL | SS_CENTERIMAGE, 12, 12, 32, 32
 LTEXT "", IDC_ABOUT_TEXT, 54, 12, 234, 96
 DEFPUSHBUTTON "OK", IDOK, 224, 112, 64, 20
END
